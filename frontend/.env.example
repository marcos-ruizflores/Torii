# Frontend env vars (Vite only exposes the ones prefixed with VITE_).
#
# Copy this file to `.env.local` for machine specific values (`.env.local` is
# gitignored), or set the variables in your hosting provider (Vercel, Netlify...)
# for the production build.

# Base URL of the Torii backend. Leave it EMPTY in dev: the Vite proxy
# (vite.config.ts) already forwards /api to the local backend, no CORS needed. In
# production point it at the real API server (its origin has to be listed in the
# backend's torii.cors.allowed-origins property):
#   VITE_API_URL=https://api.torii.example.com
VITE_API_URL=
